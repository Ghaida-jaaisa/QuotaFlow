# Copy to .env and replace the placeholder values:  cp .env.example .env
# .env is git-ignored. Never commit real credentials.

# --- PostgreSQL (docker compose) -------------------------------------------
POSTGRES_USER=quotaflow
POSTGRES_DB=quotaflow
# Required. Choose any local password; it only protects the dev database.
POSTGRES_PASSWORD=replace-with-a-local-password
# Host port for the Compose Postgres container (bound to 127.0.0.1 only).
POSTGRES_HOST_PORT=5433

# --- API --------------------------------------------------------------------
# Inside Compose the API connects to the `postgres` service; this value is
# only used when running the API directly on your machine (npm run dev:api).
DATABASE_URL=postgres://quotaflow:replace-with-a-local-password@localhost:5433/quotaflow
API_PORT=3000
DB_POOL_MAX=20
LOG_LEVEL=info
# Optional. When set (16+ chars), POST /v1/accounts requires X-Admin-Token.
# Leave empty for open self-service provisioning (convenient for the local demo).
ADMIN_TOKEN=

# --- Web client ---------------------------------------------------------------
WEB_PORT=8080

# --- Tests --------------------------------------------------------------------
# Integration tests run against a real database. It is created if missing and
# its tables are truncated at the start of every run: never point at real data.
TEST_DATABASE_URL=postgres://quotaflow:replace-with-a-local-password@localhost:5433/quotaflow_test
